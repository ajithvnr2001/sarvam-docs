[Unit]
Description=Sarvam docs incremental update (new + lastmod-stale pages only)
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/data

[Service]
Type=oneshot
User=root
WorkingDirectory=/data/opencode/sarvam
ExecStart=/usr/bin/python3 /data/opencode/sarvam/update_incremental.py --concurrency 10
# ship refreshed corpus + stamps to GitHub (token via root-only env file, never in git)
EnvironmentFile=/data/opencode/secrets/git.env
ExecStartPost=/data/opencode/sarvam/vm-ship.sh ajithvnr2001/sarvam-docs --force docs/ README.md guide_code/README.md
TimeoutStartSec=7200

[Install]
WantedBy=multi-user.target
